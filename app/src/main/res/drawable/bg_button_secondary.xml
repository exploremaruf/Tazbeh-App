<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/button_disabled" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F3E5FF" />
            <stroke android:width="1.5dp" android:color="@color/button_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Focused state (for accessibility) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F9F5FF" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Normal state (default) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>